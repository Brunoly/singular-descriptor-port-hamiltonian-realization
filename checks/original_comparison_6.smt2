(set-logic QF_NRA)
(set-option :timeout 15000)
(declare-const mult_0_0 Real)
(declare-const mult_0_1 Real)
(declare-const mult_1_0 Real)
(declare-const mult_1_1 Real)
(declare-const q_0_0 Real)
(declare-const q_0_1 Real)
(declare-const q_1_0 Real)
(declare-const q_1_1 Real)
(assert (= q_0_1 0))
(assert (= (* (- 1) q_0_1) 0))
(assert (= (+ 1 (* mult_0_0 q_0_0) (* mult_0_1 q_1_0)) 0))
(assert (= (+ (* mult_0_0 q_0_1) (* mult_0_1 q_1_1)) 0))
(assert (= (+ (* mult_1_0 q_0_0) (* mult_1_1 q_1_0)) 0))
(assert (= (+ (- 1) (* mult_1_0 q_0_1) (* mult_1_1 q_1_1)) 0))
(assert (>= q_0_0 0))
(assert (>= (* 2 q_0_0) 0))
(assert (>= (* (- 2) q_1_1) 0))
(assert (>= 2 0))
(assert (>= (+ (* (- 1) (* q_0_1 q_0_1)) (* (- 1) (* q_1_0 q_1_0)) (* (- 4) q_0_0 q_1_1) (* 2 q_0_1 q_1_0)) 0))
