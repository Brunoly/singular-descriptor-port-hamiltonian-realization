(assert (>= (* 2 (+ q_1_1 (* (- 1) (* q_1_0 q_1_0)) (* (- 2) (* q_0_1 q_0_1)) (* q_1_0 (* q_0_1 q_0_1)) (* q_1_1 (* q_0_0 q_0_0)) (* (- 1) q_0_0 (* q_1_1 q_1_1)) (* (- 1) q_0_1 q_1_1) (* (- 1) q_0_1 (* q_1_0 q_1_0)) (* (- 1) q_1_0 q_1_1) (* (- 6) q_0_0 q_1_1) (* 3 q_0_1 q_1_0) (* q_0_0 q_1_0 q_1_1) (* q_0_1 q_1_0 q_1_1) (* (- 1) q_0_0 q_0_1 q_1_0) (* (- 1) q_0_0 q_0_1 q_1_1))) 0))
(check-sat-using qfnra-nlsat)
