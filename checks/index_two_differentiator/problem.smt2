(set-logic QF_NRA)
(set-option :produce-models true)
(set-option :timeout 25000)
(declare-const K_0_0 Real)
(declare-const Z22_0_0 Real)
(declare-const epsilon Real)
(assert (> epsilon 0))
(assert (>= (+ K_0_0 (* (- 1) epsilon)) 0))
(assert (>= (* (- 2) Z22_0_0) 0))
(assert (>= (* (- 1) (* (+ (- 1) K_0_0) (+ (- 1) K_0_0))) 0))
(assert (>= (* (- 1) (* Z22_0_0 Z22_0_0)) 0))
(assert (>= (* 2 Z22_0_0 (* (+ (- 1) K_0_0) (+ (- 1) K_0_0))) 0))
(check-sat-using qfnra-nlsat)
(get-value (K_0_0 Z22_0_0 epsilon))
