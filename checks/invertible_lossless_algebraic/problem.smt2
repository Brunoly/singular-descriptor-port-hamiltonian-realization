(set-logic QF_NRA)
(set-option :produce-models true)
(set-option :timeout 25000)
(declare-const Z00_0_0 Real)
(declare-const Z00_0_1 Real)
(declare-const Z00_1_0 Real)
(declare-const Z00_1_1 Real)
(declare-const epsilon Real)
(assert (> epsilon 0))
(assert (>= (* (- 2) Z00_0_0) 0))
(assert (>= (* (- 2) Z00_1_1) 0))
(assert (>= (+ (* (- 1) (* Z00_0_1 Z00_0_1)) (* (- 1) (* Z00_1_0 Z00_1_0)) (* (- 2) Z00_0_1 Z00_1_0) (* 4 Z00_0_0 Z00_1_1)) 0))
(assert (>= (* (- 1) (* Z00_0_0 Z00_0_0)) 0))
(assert (>= (* (- 1) (* (+ 1 Z00_1_0) (+ 1 Z00_1_0))) 0))
(assert (>= (* (- 1) (* (+ (- 1) Z00_0_1) (+ (- 1) Z00_0_1))) 0))
(assert (>= (* (- 1) (* Z00_1_1 Z00_1_1)) 0))
(assert (>= (* 2 Z00_0_0 (+ 1 Z00_1_0 (* (- 1) Z00_0_1) (* Z00_0_0 Z00_1_1) (* (- 1) Z00_0_1 Z00_1_0))) 0))
(assert (>= (* 2 Z00_1_1 (+ 1 Z00_1_0 (* (- 1) Z00_0_1) (* Z00_0_0 Z00_1_1) (* (- 1) Z00_0_1 Z00_1_0))) 0))
(assert (>= (* (+ 1 Z00_1_0 (* (- 1) Z00_0_1) (* Z00_0_0 Z00_1_1) (* (- 1) Z00_0_1 Z00_1_0)) (+ 1 Z00_1_0 (* (- 1) Z00_0_1) (* Z00_0_0 Z00_1_1) (* (- 1) Z00_0_1 Z00_1_0))) 0))
(assert (not (= (+ (* Z00_0_0 Z00_1_1) (* (- 1) Z00_0_1 Z00_1_0)) 0)))
(check-sat-using qfnra-nlsat)
(get-value (Z00_0_0 Z00_0_1 Z00_1_0 Z00_1_1 epsilon))
