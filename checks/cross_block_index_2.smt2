(set-logic QF_NRA)
(set-option :timeout 20000)
(declare-const q_0_0 Real)
(declare-const q_0_1 Real)
(declare-const q_0_2 Real)
(declare-const q_1_0 Real)
(declare-const q_1_1 Real)
(declare-const q_1_2 Real)
(declare-const q_2_0 Real)
(declare-const q_2_1 Real)
(declare-const q_2_2 Real)
(assert (= q_0_1 0))
(assert (= (+ q_0_2 (* (- 1) q_1_0)) 0))
(assert (= (* (- 1) q_0_1) 0))
(assert (= (* (- 1) q_1_1) 0))
(assert (= (+ q_1_0 (* (- 1) q_0_2)) 0))
(assert (= q_1_1 0))
(assert (>= q_0_0 0))
(assert (>= q_1_2 0))
(assert (>= (+ (* q_0_0 q_1_2) (* (- 1) q_0_2 q_1_0)) 0))
(assert (>= (* 2 q_0_0) 0))
(assert (>= (* (- 2) q_1_1) 0))
(assert (>= (* (- 2) q_2_2) 0))
(assert (>= (+ (* (- 1) (* q_0_1 q_0_1)) (* (- 1) (* q_1_0 q_1_0)) (* (- 4) q_0_0 q_1_1) (* 2 q_0_1 q_1_0)) 0))
(assert (>= (+ (* (- 1) (* q_0_2 q_0_2)) (* (- 1) (* q_2_0 q_2_0)) (* (- 4) q_0_0 q_2_2) (* 2 q_0_2 q_2_0)) 0))
(assert (>= (+ (* (- 1) (* q_1_2 q_1_2)) (* (- 1) (* q_2_1 q_2_1)) (* (- 2) q_1_2 q_2_1) (* 4 q_1_1 q_2_2)) 0))
(assert (>= (* 2 (+ (* q_1_1 (* q_0_2 q_0_2)) (* q_1_1 (* q_2_0 q_2_0)) (* q_2_2 (* q_0_1 q_0_1)) (* q_2_2 (* q_1_0 q_1_0)) (* (- 1) q_0_0 (* q_1_2 q_1_2)) (* (- 1) q_0_0 (* q_2_1 q_2_1)) (* q_0_1 q_1_2 q_2_0) (* q_0_1 q_2_0 q_2_1) (* q_0_2 q_1_0 q_1_2) (* q_0_2 q_1_0 q_2_1) (* (- 1) q_0_1 q_0_2 q_1_2) (* (- 1) q_0_1 q_0_2 q_2_1) (* (- 1) q_1_0 q_1_2 q_2_0) (* (- 1) q_1_0 q_2_0 q_2_1) (* (- 2) q_0_0 q_1_2 q_2_1) (* (- 2) q_0_1 q_1_0 q_2_2) (* (- 2) q_0_2 q_1_1 q_2_0) (* 4 q_0_0 q_1_1 q_2_2))) 0))
(assert (> (+ (* q_0_1 q_0_1) (* q_0_2 q_0_2)) 0))
(check-sat-using qfnra-nlsat)
