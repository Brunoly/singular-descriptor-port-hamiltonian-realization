(set-logic QF_NRA)
(set-option :produce-models true)
(set-option :timeout 25000)
(declare-const X_0_0 Real)
(declare-const Y0_0_0 Real)
(declare-const Z00_0_0 Real)
(declare-const epsilon Real)
(assert (> epsilon 0))
(assert (>= (+ X_0_0 (* (- 1) epsilon)) 0))
(assert (>= (* (- 2) X_0_0) 0))
(assert (>= (* (- 2) Z00_0_0) 0))
(assert (>= (+ (* (- 1) (* Y0_0_0 Y0_0_0)) (* 4 X_0_0 Z00_0_0)) 0))
(assert (not (= Z00_0_0 0)))
(check-sat-using qfnra-nlsat)
(get-value (X_0_0 Y0_0_0 Z00_0_0 epsilon))
